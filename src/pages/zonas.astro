---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import zonas from '../data/zonas.json';
import { getPropiedades, buscarHref } from '../lib';
const todas = await getPropiedades();
const conteo = (b: string) => todas.filter((p) => p.data.barrio === b || p.data.localidad === b).length;
const conteoPartido = (z: { nombre: string; barrios: string[] }) => todas.filter((p) => p.data.localidad === z.nombre || z.barrios.includes(p.data.barrio)).length;
const regiones = [
  { id: 'Zona Norte', titulo: 'Zona Norte', texto: 'Vicente López, San Isidro y San Fernando: conocemos cada barrio, sus colegios, clubes, accesos y lo que vale cada metro.' },
  { id: 'CABA', titulo: 'Ciudad de Buenos Aires', texto: 'A minutos de Zona Norte cruzando la General Paz. Compramos, vendemos y tasamos en todos los barrios porteños.' },
  { id: 'Otras zonas', titulo: 'Otras zonas', texto: 'Proyectos seleccionados fuera del AMBA.' },
];
---
<Layout title="Zonas" description="Dónde trabajamos: CABA, Vicente López, San Isidro, San Fernando, Victoria y San Antonio de Areco.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Dónde operamos</span>
      <div class="top">
        <h1 class="display" style="color:var(--tide)">CABA y <em>Zona Norte.</em></h1>
        <p class="lead">Comprá, vendé o tasá tu propiedad de los dos lados de la General Paz, con el mismo equipo y la misma atención personalizada.</p>
      </div>
      <nav class="jump" aria-label="Regiones">
        {regiones.map((r) => <a href={`#${r.id === 'CABA' ? 'caba' : r.id === 'Zona Norte' ? 'zona-norte' : 'otras'}`}>{r.titulo}</a>)}
      </nav>
    </div>
  </section>

  {regiones.map((r) => {
    const ps = zonas.partidos.filter((p) => p.region === r.id);
    if (!ps.length) return null;
    const anchor = r.id === 'CABA' ? 'caba' : r.id === 'Zona Norte' ? 'zona-norte' : 'otras';
    return (
      <section class="section region" id={anchor}>
        <div class="wrap">
          <div class="region__head">
            <h2 class="h2" style="color:var(--tide)">{r.titulo}</h2>
            <p class="lead">{r.texto}</p>
          </div>
          <div class="partidos">
            {ps.map((p) => {
              const n = conteoPartido(p);
              return (
                <article class:list={{ wide: p.barrios.length > 20 }}>
                  <a class="partido" href={n ? buscarHref({ zona: p.nombre }) : '/contacto/'}>
                    <h3>{p.nombre}</h3>
                    <span>{n ? `Ver ${n} ${n === 1 ? 'propiedad' : 'propiedades'}` : 'Consultanos'}</span>
                  </a>
                  <ul>
                    {p.barrios.map((b) => {
                      const k = conteo(b);
                      return <li>{k > 0 ? <a href={buscarHref({ zona: b })} class="has">{b}<span>{k}</span></a> : <span class="z">{b}</span>}</li>;
                    })}
                  </ul>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section dark">
    <div class="wrap cta">
      <h2 class="h2">¿Tu propiedad está <em>en alguna de estas zonas?</em></h2>
      <div class="cta__btns">
        <a class="btn btn-coral" href="/servicios/tasaciones/#form">Tasá tu propiedad <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="/contacto/">Consultanos</a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .top { display: grid; grid-template-columns: 1.3fr 1fr; gap: 6vw; align-items: end; margin-bottom: 40px; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; }
  .jump a { padding: 10px 18px; border: 1px solid var(--tide); border-radius: 999px; font-size: 14px; font-weight: 700; }
  .jump a:hover { background: var(--tide); color: var(--sand); }
  .region { padding-top: 0; }
  .region__head { display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; align-items: end; padding-top: 48px; margin-bottom: 32px; border-top: 1px solid var(--line); }
  .partidos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px; }
  .partidos article { padding: 22px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; }
  .partidos article.wide { grid-column: 1 / -1; }
  .partidos article.wide ul { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); column-gap: 24px; }
  .partido { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .partido h3 { font-size: 22px; letter-spacing: -.03em; color: var(--tide); }
  .partido span { font-size: 12px; font-weight: 700; color: var(--coral); white-space: nowrap; }
  .partido:hover h3 { color: var(--coral); }
  .partidos ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .partidos li a { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 15px; color: var(--muted); }
  .partidos li a.has { font-weight: 700; color: var(--tide); }
  .partidos li a:hover { color: var(--coral); }
  .partidos li .z { display: block; padding: 6px 0; font-size: 15px; color: var(--muted); }
  .partidos li a span { min-width: 24px; padding: 0 8px; border-radius: 999px; background: var(--coral); color: var(--tide); font-size: 12px; text-align: center; line-height: 22px; }
  .cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  .cta .h2 { max-width: 18ch; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 860px) { .top, .region__head { grid-template-columns: 1fr; gap: 20px; } }
</style>
