---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import QuickSearch from '../components/QuickSearch.astro';
import ServiceCards from '../components/ServiceCards.astro';
import SellSteps from '../components/SellSteps.astro';
import TasacionForm from '../components/TasacionForm.astro';
import Icon from '../components/Icon.astro';
import sitio from '../data/sitio.json';
import Faq from '../components/Faq.astro';
import TeamSection from '../components/TeamSection.astro';
import faq from '../data/faq.json';
import { getPropiedades, waLink, img } from '../lib';
import { faqPage, fill } from '../seo';

const todas = await getPropiedades();
const marcadas = todas.filter((p) => p.data.destacada);
const destacadas = [...marcadas, ...todas.filter((p) => !p.data.destacada)].slice(0, Math.max(3, Math.ceil(marcadas.length / 3) * 3));
const heroImg = img(destacadas[0]?.data.portada ?? '/uploads/propiedades/chubut-lomas-de-san-isidro-01.webp', 2000);
const nosotrosParrafos = sitio.nosotros_texto.split(/\n\s*\n/);
const t = sitio.nosotros_titulo.trim();
const tLast = t.match(/\S+$/)?.[0] ?? '';
const tFirst = t.slice(0, t.length - tLast.length);
---
<Layout overlayHeader schema={[faqPage(faq.items)]}>
  <section class="hero">
    <div class="hero__bg" style={`background-image:url('${heroImg}')`} aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <span class="eyebrow hero__eyebrow">{sitio.zona}</span>
      <h1 class="hero__title">{sitio.hero_titulo}</h1>
      <p class="hero__text">{sitio.hero_texto}</p>
      <div class="hero__choices">
        <a class="choice" href="/servicios/comprar/">Comprar</a>
        <a class="choice" href="/servicios/vender/">Vender</a>
        <a class="choice" href="/servicios/tasaciones/">Tasar</a>
        <a class="choice" href="/servicios/asesoramiento/">Asesoramiento</a>
      </div>
      <div class="hero__search"><QuickSearch /></div>
    </div>
  </section>

  <div class="ribbon">
    <div class="wrap ribbon__inner">
      <span class="ribbon__tag">Zonas</span>
      <span>Trabajamos en {sitio.trabajamos_en}.</span>
      <a href="/propiedades/">Ver propiedades <Icon name="arrow" /></a>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="eyebrow">Propiedades destacadas</span>
          <h2 class="h2">Encontrá tu <em>lugar.</em></h2>
        </div>
        <a class="btn btn-ghost" href="/propiedades/">Ver todas las propiedades <Icon name="arrow" /></a>
      </div>
      <div class="cards">
        {destacadas.map((p, i) => <PropertyCard p={p} eager={i < 2} />)}
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="eyebrow">Servicios</span>
          <h2 class="h2">Todo lo que necesitás, <em>en un lugar.</em></h2>
        </div>
        <p class="lead head__p">Compra, venta, tasaciones y asesoramiento inmobiliario con atención personalizada de principio a fin.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <TeamSection />

  <section class="section">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="eyebrow">¿Querés vender?</span>
          <h2 class="h2">Te acompañamos <em>en cada paso.</em></h2>
        </div>
        <a class="btn btn-tide" href="/servicios/vender/">Cómo vendemos tu propiedad <Icon name="arrow" /></a>
      </div>
      <SellSteps />
    </div>
  </section>

  <section class="section paper" id="nosotros">
    <div class="wrap about">
      <div>
        <span class="eyebrow">Nosotros</span>
        <h2 class="h2">{tFirst}<em>{tLast}</em></h2>
      </div>
      <div>
        <div class="stack">{nosotrosParrafos.map((p) => <p class="lead">{p}</p>)}</div>
        <a class="btn btn-ghost" href="/nosotros/">Conocenos <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" id="preguntas">
    <div class="wrap"><Faq items={faq.items.map((f) => ({ ...f, respuesta: fill(f.respuesta) }))} titulo={faq.titulo} /></div>
  </section>

  <section class="section dark" id="tasar">
    <div class="wrap tasar">
      <div>
        <span class="eyebrow">Tasá tu inmueble online</span>
        <h2 class="h2">¿Cuánto vale <em>tu propiedad?</em></h2>
        <p class="lead">Completá el formulario y te contactamos para coordinar una visita. La tasación no tiene costo ni compromiso.</p>
        <a class="btn btn-ghost" href={waLink(sitio.whatsapp, 'Hola Costa & Co, quiero tasar mi propiedad.')} target="_blank" rel="noopener" style="margin-top:28px"><Icon name="whatsapp" /> Prefiero WhatsApp</a>
      </div>
      <div class="tasar__card"><TasacionForm /></div>
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; display: flex; min-height: min(100svh, 920px); color: var(--sand); background: var(--tide-deep); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5, 5, 5,.62) 0%, rgba(5, 5, 5,.38) 45%, rgba(5, 5, 5,.86) 100%); }
  .hero__inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 130px; padding-bottom: 56px; text-align: center; }
  .hero__eyebrow { color: var(--coral); font-size: 13px; letter-spacing: .2em; text-shadow: 0 1px 12px rgba(0,0,0,.5); }
  .hero__title { max-width: 16ch; font-size: clamp(40px, 6.4vw, 96px); font-weight: 600; line-height: .96; letter-spacing: -.05em; text-wrap: balance; }
  .hero__text { max-width: 540px; margin-top: 22px; font-size: clamp(16px, 1.3vw, 19px); color: rgba(245, 245, 242,.85); }
  .hero__choices { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; width: min(100%, 860px); margin-top: 40px; }
  .choice { display: grid; place-items: center; min-height: 64px; padding: 14px 18px; border: 1px solid rgba(245, 245, 242,.4); border-radius: 12px; background: rgba(5, 5, 5,.35); backdrop-filter: blur(6px); font-size: 22px; font-weight: 700; letter-spacing: -.03em; transition: background .18s, color .18s, border-color .18s; }
  .choice:hover { background: var(--sand); color: var(--tide); border-color: var(--sand); }
  .hero__search { width: min(100%, 1040px); margin-top: 28px; text-align: left; }

  .ribbon { background: var(--tide); color: var(--sand); font-size: 14px; }
  .ribbon__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 16px; padding-block: 14px; text-align: center; }
  .ribbon__tag { padding: 4px 10px; border-radius: 999px; background: var(--coral); color: var(--tide-deep); font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .ribbon a { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .ribbon a :global(svg) { width: 14px; }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 48px; margin-bottom: clamp(36px, 5vw, 64px); }
  .head__p { max-width: 460px; }
  .head .h2 { color: var(--tide); }
  .dark .h2 { color: var(--sand); }

  .about { display: grid; grid-template-columns: 1fr 1.1fr; gap: 6vw; align-items: start; }
  .about .h2 { color: var(--tide); }
  .stack { display: grid; gap: 18px; margin-bottom: 32px; max-width: 620px; }

  .tasar { display: grid; grid-template-columns: 1fr 1.2fr; gap: 6vw; align-items: start; }
  .tasar .lead { margin-top: 24px; }
  .tasar__card { padding: clamp(22px, 3vw, 36px); background: var(--paper); color: var(--ink); border-radius: 4px; }

  @media (max-width: 900px) {
    .hero__choices { grid-template-columns: 1fr 1fr; }
    .about, .tasar { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 480px) { .choice { font-size: 18px; padding: 12px 14px; } }
</style>
