---
import Layout from '../layouts/Layout.astro';
---
<Layout title="¡Gracias!" noindex>
  <section class="section">
    <div class="wrap" style="min-height:50vh;display:grid;align-content:center;gap:28px">
      <span class="eyebrow">Consulta enviada</span>
      <h1 class="display" style="color:var(--tide)">¡Gracias! Ya recibimos <em>tu mensaje.</em></h1>
      <p class="lead">Te vamos a contactar dentro de las próximas 24 horas hábiles.</p>
      <div><a class="btn btn-tide" href="/propiedades/">Seguir viendo propiedades</a></div>
    </div>
  </section>
</Layout>
