---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada">
  <section class="section">
    <div class="wrap" style="min-height:50vh;display:grid;align-content:center;gap:28px">
      <span class="eyebrow">Error 404</span>
      <h1 class="display" style="color:var(--tide)">Esta dirección <em>no existe.</em></h1>
      <div><a class="btn btn-tide" href="/propiedades/">Ver propiedades</a></div>
    </div>
  </section>
</Layout>
