---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import sitio from '../../data/sitio.json';
import ShareBox from '../../components/ShareBox.astro';
import { inmueble, breadcrumbs } from '../../seo';
import { getPropiedades, fotos, precioTexto, estadoClase, waLink, img, parseVideo, type Propiedad } from '../../lib';

export async function getStaticPaths() {
  const todas = await getPropiedades();
  return todas.map((p) => ({ params: { id: p.id }, props: { p, todas } }));
}

const { p, todas } = Astro.props as { p: Propiedad; todas: Propiedad[] };
const d = p.data;
const { Content } = await render(p);
const imgs = fotos(d);
const planos = d.planos;
const todasImgs = [...imgs, ...planos];
const lugar = [d.direccion, d.barrio, d.localidad && d.localidad !== d.barrio ? d.localidad : null].filter(Boolean).join(' · ');
const specs = [
  ['Ambientes', d.ambientes],
  ['Dormitorios', d.dormitorios],
  ['Baños', d.banos],
  ['Cocheras', d.cocheras],
  ['Sup. total', d.sup_total && `${d.sup_total} m²`],
  ['Sup. cubierta', d.sup_cubierta && `${d.sup_cubierta} m²`],
  ['Lote', d.lote && `${d.lote} m²`],
  ['Jardín', d.jardin && `${d.jardin} m²`],
  ['Entrega', d.estado !== 'Vendida' ? d.entrega : null],
].filter(([, v]) => v) as [string, string | number][];
const wa = waLink(sitio.whatsapp, `Hola Costa & Co, me interesa la propiedad "${d.titulo}". ${Astro.site ? new URL(`/propiedades/${p.id}/`, Astro.site) : ''}`);
const otras = todas.filter((o) => o.id !== p.id && o.data.estado !== 'Vendida').slice(0, 3);
const metaDesc = [`${d.tipo} en ${d.operacion.toLowerCase()} en ${d.barrio}${d.localidad && d.localidad !== d.barrio ? `, ${d.localidad}` : ''}.`, [d.ambientes && `${d.ambientes} ambientes`, d.dormitorios && `${d.dormitorios} dormitorios`, (d.sup_total || d.sup_cubierta) && `${d.sup_total || d.sup_cubierta} m²`].filter(Boolean).join(', ') + '.', d.estado !== 'Disponible' ? `Estado: ${d.estado}.` : '', d.resumen].filter(Boolean).join(' ').replace(/\.\./g, '.').slice(0, 300);
const videos = [...d.videos, ...(d.video ? [d.video] : [])].map(parseVideo).filter((v) => v !== null);
---
<Layout title={d.titulo} description={metaDesc} image={d.portada} schema={[inmueble(p, todasImgs), breadcrumbs([['Propiedades', '/propiedades/'], [d.titulo, `/propiedades/${p.id}/`]])]}>
  <article class="prop">
    <div class="wrap">
      <nav class="crumbs" aria-label="Ruta"><a href="/propiedades/">Propiedades</a><span>/</span><span>{d.barrio}</span></nav>
      <header class="prop__head">
        <div>
          <div class="prop__tags">
            <span class={`pill ${estadoClase(d.estado)}`}>{d.estado}</span>
            <span class="prop__type">{d.tipo} · {d.operacion}</span>
          </div>
          <h1 class="prop__title">{d.titulo}</h1>
          <p class="prop__place"><Icon name="pin" /> {lugar}</p>
        </div>
        <div class="prop__price">
          <span>{d.estado === 'Vendida' ? 'Estado' : 'Precio'}</span>
          <strong>{precioTexto(d)}</strong>
        </div>
      </header>

      <div class="gallery" data-gallery>
        {imgs.slice(0, 5).map((src, i) => (
          <button class:list={['gallery__item', { 'gallery__item--main': i === 0 }]} data-open={i} aria-label={`Ver foto ${i + 1} de ${todasImgs.length}`}>
            <img src={img(src, i === 0 ? 1600 : 800)} alt={`${d.titulo}, foto ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} width="1200" height="800" />
            {i === Math.min(4, imgs.length - 1) && todasImgs.length > 1 && (
              <span class="gallery__more gallery__more--desk"><Icon name="expand" /> Ver {todasImgs.length} fotos{planos.length ? ' y planos' : ''}</span>
            )}
            {i === 0 && todasImgs.length > 1 && (
              <span class="gallery__more gallery__more--mob"><Icon name="expand" /> {todasImgs.length} fotos</span>
            )}
          </button>
        ))}
      </div>

      <div class="prop__layout">
        <div class="prop__main">
          {specs.length > 0 && (
            <dl class="specs">
              {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}

          {d.resumen && <p class="prop__lead">{d.resumen}</p>}
          <div class="prose"><Content /></div>

          {d.terminaciones.length > 0 && (
            <section class="block">
              <h2>Terminaciones y materiales</h2>
              <ul class="checks">{d.terminaciones.map((t) => <li>{t}</li>)}</ul>
            </section>
          )}

          {planos.length > 0 && (
            <section class="block">
              <h2>Planos</h2>
              <div class="planos">
                {planos.map((src, i) => (
                  <button class="plano" data-open={imgs.length + i} aria-label={`Ampliar plano ${i + 1}`}>
                    <img src={img(src, 900)} alt={`Plano ${i + 1} de ${d.titulo}`} loading="lazy" width="1200" height="800" />
                  </button>
                ))}
              </div>
            </section>
          )}

          {videos.length > 0 && (
            <section class="block">
              <h2>{videos.length > 1 ? 'Videos' : 'Video'}</h2>
              <div class="videos">
                {videos.map((v) => (
                  <div class:list={['video', `video--${v.tipo}`]}>
                    <iframe src={v.src} title={`Video de ${d.titulo}`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; clipboard-write" allowfullscreen scrolling="no"></iframe>
                    <a class="video__link" href={v.url} target="_blank" rel="noopener"><Icon name="play" /> Ver en {v.tipo === 'youtube' ? 'YouTube' : 'Instagram'}</a>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="prop__aside">
          <div class="aside-card">
            <p class="aside-card__title">¿Te interesa esta propiedad?</p>
            <a class="btn btn-coral btn-block" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> Consultar por WhatsApp</a>
            <div class="aside-card__or"><span>o dejanos tus datos</span></div>
            <ContactForm propiedad={d.titulo} compact />
            <ShareBox id={p.id} titulo={d.titulo} />
          </div>
        </aside>
      </div>
    </div>

    {otras.length > 0 && (
      <section class="section paper">
        <div class="wrap">
          <div class="section-label"><span>+</span><span>Otras propiedades</span></div>
          <div class="cards">{otras.map((o) => <PropertyCard p={o} />)}</div>
        </div>
      </section>
    )}
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Galería de fotos">
    <button class="lb-btn lb-close" data-close aria-label="Cerrar"><Icon name="close" /></button>
    <button class="lb-btn lb-prev" data-prev aria-label="Anterior"><Icon name="chev-l" /></button>
    <img data-lb-img alt="" />
    <button class="lb-btn lb-next" data-next aria-label="Siguiente"><Icon name="chev-r" /></button>
    <p class="lb-count" data-lb-count></p>
  </dialog>
  <script type="application/json" data-imgs set:html={JSON.stringify(todasImgs.map((s) => img(s, 2000)))} />
</Layout>

<script>
  const imgs: string[] = JSON.parse(document.querySelector('[data-imgs]')!.textContent || '[]');
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cnt = dlg.querySelector('[data-lb-count]')!;
  let i = 0;
  const show = (n: number) => {
    i = (n + imgs.length) % imgs.length;
    img.src = imgs[i];
    img.alt = `Foto ${i + 1} de ${imgs.length}`;
    cnt.textContent = `${i + 1} / ${imgs.length}`;
  };
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => { show(Number(b.dataset.open)); dlg.showModal(); }),
  );
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .prop { padding-top: 28px; }
  .crumbs { display: flex; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .crumbs a { color: var(--coral); }
  .prop__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; padding: 28px 0 32px; }
  .prop__tags { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .prop__type { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .prop__title { max-width: 900px; font-size: clamp(34px, 4.6vw, 68px); font-weight: 700; line-height: 1; letter-spacing: -.05em; color: var(--tide); }
  .prop__place { display: flex; align-items: center; gap: 8px; margin-top: 16px; font-weight: 600; color: var(--muted); }
  .prop__place :global(svg) { width: 18px; height: 18px; color: var(--coral); flex: none; }
  .prop__price { text-align: right; }
  .prop__price span { display: block; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .prop__price strong { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3vw, 44px); color: var(--coral); }

  .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 8px; height: clamp(320px, 52vw, 640px); }
  .gallery__item { position: relative; padding: 0; border: 0; overflow: hidden; background: #e4e4e0; }
  .gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .gallery__item:hover img { transform: scale(1.03); }
  .gallery__item--main { grid-row: span 2; }
  .gallery__more { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 999px; background: var(--paper); color: var(--tide); font-size: 12px; font-weight: 700; }
  .gallery__more :global(svg) { width: 16px; height: 16px; }
  .gallery__more--mob { display: none; }

  .prop__layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(32px, 5vw, 80px); padding: clamp(40px, 5vw, 72px) 0 clamp(72px, 8vw, 120px); }
  .specs { margin: 0 0 40px; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .specs div { padding: 18px 18px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .specs dt { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .specs dd { margin: 6px 0 0; font-size: 22px; font-weight: 700; letter-spacing: -.03em; color: var(--tide); }
  .prop__lead { margin-bottom: 28px; font-family: var(--serif); font-size: clamp(24px, 2.4vw, 34px); line-height: 1.2; color: var(--tide); }
  .prose { max-width: 720px; color: #2b2d2c; font-size: 17px; line-height: 1.75; }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(h2) { margin: 1.8em 0 .6em; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--coral); }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(strong) { color: var(--tide); }
  .block { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--line); }
  .block h2 { margin-bottom: 20px; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--coral); }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 32px; }
  .checks li { position: relative; padding-left: 28px; color: #2b2d2c; }
  .checks li::before { content: ""; position: absolute; left: 0; top: .5em; width: 14px; height: 8px; border-left: 2px solid var(--tide); border-bottom: 2px solid var(--tide); transform: rotate(-45deg); }
  .planos { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .plano { padding: 12px; border: 1px solid var(--line); background: #fff; }
  .plano img { width: 100%; aspect-ratio: 4/3; object-fit: contain; }
  .videos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 20px; align-items: start; }
  .video { display: grid; gap: 8px; }
  .video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 10px; background: #000; }
  .video--instagram iframe { aspect-ratio: auto; height: 620px; max-width: 420px; background: #fff; border: 1px solid var(--line); }
  .videos:has(.video--youtube):not(:has(.video:nth-child(2))) { grid-template-columns: 1fr; }
  .video__link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: var(--ink); }
  .video__link :global(svg) { width: 14px; height: 14px; color: var(--coral); }

  .prop__aside { position: relative; }
  .aside-card { position: sticky; top: 100px; display: grid; gap: 16px; padding: 28px; background: var(--paper); border: 1px solid var(--line); }
  .aside-card__title { font-size: 20px; font-weight: 700; letter-spacing: -.03em; color: var(--tide); }
  .aside-card__or { display: flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .aside-card__or::before, .aside-card__or::after { content: ""; flex: 1; height: 1px; background: var(--line); }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(5, 5, 5, .97); color: #fff; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(5, 5, 5, .97); }
  .lightbox img { max-width: calc(100vw - 32px); max-height: calc(100dvh - 120px); object-fit: contain; }
  .lb-btn { position: absolute; width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.25); border-radius: 50%; background: rgba(0,0,0,.3); color: #fff; }
  .lb-btn :global(svg) { width: 22px; height: 22px; }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: .1em; }

  @media (max-width: 980px) {
    .prop__layout { grid-template-columns: 1fr; }
    .aside-card { position: static; }
  }
  @media (max-width: 700px) {
    .prop__price { text-align: left; }
    .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: auto; height: auto; }
    .gallery__item { aspect-ratio: 4/3; }
    .gallery__item--main { grid-column: span 2; grid-row: auto; }
    .gallery__item:nth-child(n+4) { display: none; }
    .gallery__more--desk { display: none; }
    .gallery__more--mob { display: inline-flex; }
    .checks { grid-template-columns: 1fr; }
        .lb-prev, .lb-next { top: auto; bottom: 8px; transform: none; }
  }
</style>
