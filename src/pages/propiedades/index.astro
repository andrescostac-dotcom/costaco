---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import ZonaOptions from '../../components/ZonaOptions.astro';
import MapaPropiedades from '../../components/MapaPropiedades.astro';
import zonas from '../../data/zonas.json';
import seo from '../../data/seo.json';
import { getPropiedades, buscarHref } from '../../lib';
import { breadcrumbs } from '../../seo';

const todas = await getPropiedades();
const estados = ['Disponible', 'Pre-Venta', 'En Obra', 'Reservada', 'Vendida'].filter((e) => todas.some((p) => p.data.estado === e));
const operaciones = [...new Set(todas.map((p) => p.data.operacion))];
const tipos = [...new Set(todas.map((p) => p.data.tipo))];
const ambs = [1, 2, 3, 4, 5].filter((n) => todas.some((p) => (p.data.ambientes ?? 0) >= n));
// Cada propiedad suma en su grupo (partido / CABA / otras zonas)
const grupoDe = (barrio: string, localidad?: string | null) =>
  zonas.partidos.find((z) => z.nombre === localidad) ?? zonas.partidos.find((z) => z.barrios.includes(barrio));
const counts: Record<string, number> = {};
todas.forEach((p) => { const g = grupoDe(p.data.barrio, p.data.localidad); if (g) counts[g.nombre] = (counts[g.nombre] ?? 0) + 1; });
const gruposConProps = zonas.partidos.filter((z) => counts[z.nombre]);
const zonaMap = Object.fromEntries(zonas.partidos.map((z) => [z.nombre, z.barrios]));
---
<Layout fullTitle={seo.paginas.propiedades.titulo} description={seo.paginas.propiedades.descripcion || undefined} schema={[breadcrumbs([['Propiedades', '/propiedades/']]), { '@type': 'ItemList', itemListElement: todas.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://costaco.life/propiedades/${p.id}/`, name: p.data.titulo })) }]}>
  <section class="intro">
    <div class="wrap">
      <span class="eyebrow">Propiedades en Buenos Aires</span>
      <h1 class="display">Es lindo llegar a casa. <em>Mejor es encontrarla.</em></h1>
    </div>
  </section>

  <div class="bar-wrap">
    <div class="wrap">
      <form class="bar" aria-label="Filtrar propiedades" onsubmit="return false">
        <label for="f-operacion"><span>Operación</span>
          <select data-k="operacion" id="f-operacion"><option value="">Todas</option>{operaciones.map((o) => <option>{o}</option>)}</select>
        </label>
        <label for="f-zona"><span>Zona</span>
          <select data-k="zona" id="f-zona"><option value="">Todas las zonas</option><ZonaOptions /></select>
        </label>
        <label for="f-tipo"><span>Tipo</span>
          <select data-k="tipo" id="f-tipo"><option value="">Todos</option>{tipos.map((t) => <option>{t}</option>)}</select>
        </label>
        <label for="f-amb"><span>Ambientes</span>
          <select data-k="amb" id="f-amb"><option value="">Todos</option>{ambs.map((n) => <option value={String(n)}>{n}+</option>)}</select>
        </label>
        <label for="f-estado"><span>Estado</span>
          <select data-k="estado" id="f-estado"><option value="">Todos</option>{estados.map((e) => <option>{e}</option>)}</select>
        </label>
        <label for="f-sort" class="bar__sort"><span>Ordenar</span>
          <select data-sort id="f-sort">
            <option value="rel">Relevancia</option>
            <option value="sdesc">Mayor superficie</option>
            <option value="amb">Más ambientes</option>
            <option value="pasc">Menor precio</option>
            <option value="pdesc">Mayor precio</option>
          </select>
        </label>
      </form>
    </div>
  </div>

  <section class="wrap results">
    <div class="list__bar">
      <p aria-live="polite"><strong data-count>{todas.length}</strong> propiedades</p>
      <div class="active" data-active-tags></div>
      <button type="button" class="link" data-reset hidden>Limpiar filtros</button>
    </div>
    <div class="cards" data-list>
      {todas.map((p, i) => <PropertyCard p={p} eager={i < 4} />)}
    </div>
    <div class="empty" data-empty hidden>
      <p><strong>No encontramos propiedades con esos filtros.</strong></p>
      <p>Probá ampliar la búsqueda o contanos qué estás buscando y te avisamos cuando ingrese algo para vos.</p>
      <div class="empty__actions"><button type="button" class="btn btn-ghost" data-reset>Ver todas</button><a class="btn btn-tide" href="/contacto/">Contanos qué buscás</a></div>
    </div>
  </section>

  <section class="section paper mapa-sec">
    <div class="wrap">
      <span class="eyebrow">Mapa</span>
      <h2 class="h2" style="margin-bottom:28px">Dónde están <em>nuestras propiedades.</em></h2>
      <MapaPropiedades props={todas} altura="520px" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Explorá por zona</span>
      <div class="zones">
        {gruposConProps.map((z) => <a href={buscarHref({ zona: z.nombre })} data-zone={z.nombre}><strong>{z.nombre}</strong><span>{counts[z.nombre]} {counts[z.nombre] === 1 ? 'propiedad' : 'propiedades'}</span></a>)}
        <a href="/contacto/" class="zones__all"><strong>¿Buscás en otra zona?</strong><span>Consultanos</span></a>
      </div>
    </div>
  </section>
  <script type="application/json" data-zonas set:html={JSON.stringify(zonaMap)} />
</Layout>

<script>
  const KEYS = ['operacion', 'zona', 'tipo', 'amb', 'estado', 'sort'] as const;
  type K = (typeof KEYS)[number];
  const blank = (): Record<K, string> => ({ operacion: '', zona: '', tipo: '', amb: '', estado: '', sort: 'rel' });
  const st = blank();
  const zonaMap: Record<string, string[]> = JSON.parse(document.querySelector('[data-zonas]')?.textContent || '{}');
  const grupoDe = (barrio: string) => Object.keys(zonaMap).find((g) => zonaMap[g].includes(barrio));

  function readUrl() {
    Object.assign(st, blank());
    const q = new URLSearchParams([location.search.slice(1), location.hash.slice(1)].filter(Boolean).join('&'));
    if (q.get('barrio') && !q.get('zona')) q.set('zona', q.get('barrio')!);
    KEYS.forEach((k) => { const v = q.get(k); if (v) st[k] = v; });
    // Si llega una zona sin propiedades en el filtro, la llevamos a su grupo
    const sel = document.getElementById('f-zona') as HTMLSelectElement;
    if (st.zona && !Array.from(sel.options).some((o) => o.value === st.zona)) st.zona = grupoDe(st.zona) ?? st.zona;
  }

  const list = document.querySelector<HTMLElement>('[data-list]')!;
  const cards = Array.from(list.querySelectorAll<HTMLElement>('.card'));
  cards.forEach((c, i) => (c.dataset.i = String(i)));
  const all = <T extends Element>(s: string) => Array.from(document.querySelectorAll<T>(s));

  const matchZona = (d: DOMStringMap, z: string) =>
    !z || d.barrio === z || d.localidad === z || (zonaMap[z] ?? []).includes(d.barrio || '');

  function renderTags() {
    const box = document.querySelector<HTMLElement>('[data-active-tags]')!;
    box.innerHTML = '';
    (['operacion', 'zona', 'tipo', 'amb', 'estado'] as const).forEach((k) => {
      if (!st[k]) return;
      const label = k === 'amb' ? `${st[k]}+ ambientes` : st[k];
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tag';
      b.innerHTML = '<span></span><i aria-hidden="true">✕</i>';
      b.querySelector('span')!.textContent = label;
      b.setAttribute('aria-label', `Quitar filtro ${label}`);
      b.addEventListener('click', () => { st[k] = ''; apply(); });
      box.appendChild(b);
    });
  }

  function apply() {
    let n = 0;
    cards.forEach((c) => {
      const d = c.dataset;
      const ok = (!st.operacion || d.operacion === st.operacion) && matchZona(d, st.zona) && (!st.tipo || d.tipo === st.tipo)
        && (!st.amb || Number(d.amb) >= Number(st.amb)) && (!st.estado || d.estado === st.estado);
      c.hidden = !ok;
      if (ok) n++;
    });
    const key = (c: HTMLElement) => {
      const d = c.dataset;
      if (st.sort === 'pasc') return Number(d.precio) || 1e15;
      if (st.sort === 'pdesc') return -(Number(d.precio) || -1e15);
      if (st.sort === 'sdesc') return -Number(d.sup);
      if (st.sort === 'amb') return -Number(d.amb);
      return Number(d.i);
    };
    cards.slice().sort((a, b) => key(a) - key(b) || Number(a.dataset.i) - Number(b.dataset.i)).forEach((c) => list.appendChild(c));
    document.querySelector('[data-count]')!.textContent = String(n);
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    const active = (['operacion', 'zona', 'tipo', 'amb', 'estado'] as const).some((k) => st[k]);
    document.querySelector<HTMLElement>('.list__bar [data-reset]')!.hidden = !active;
    all<HTMLSelectElement>('select[data-k]').forEach((s) => { s.value = st[s.dataset.k as K]; s.classList.toggle('on', !!s.value); });
    document.querySelector<HTMLSelectElement>('[data-sort]')!.value = st.sort;
    const out = new URLSearchParams();
    KEYS.forEach((k) => { if (st[k] && !(k === 'sort' && st[k] === 'rel')) out.set(k, st[k]); });
    try { history.replaceState(null, '', location.pathname + (out.toString() ? '#' + out.toString() : '')); } catch (e) { /* visor sin historial */ }
    renderTags();
    window.dispatchEvent(new CustomEvent('cc:filtrado', { detail: cards.filter((c) => !c.hidden).map((c) => c.dataset.id) }));
  }

  all<HTMLSelectElement>('select[data-k]').forEach((s) => s.addEventListener('change', () => { st[s.dataset.k as K] = s.value; apply(); }));
  document.querySelector<HTMLSelectElement>('[data-sort]')!.addEventListener('change', (e) => { st.sort = (e.target as HTMLSelectElement).value; apply(); });
  all('[data-reset]').forEach((b) => b.addEventListener('click', () => { Object.assign(st, blank()); apply(); }));
  all<HTMLAnchorElement>('[data-zone]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); st.zona = a.dataset.zone!; apply(); document.querySelector('.bar-wrap')!.scrollIntoView({ behavior: 'smooth' }); }));
  window.addEventListener('hashchange', () => { readUrl(); apply(); });

  readUrl();
  apply();
</script>

<style>
  .intro { padding: clamp(40px, 5vw, 72px) 0 clamp(24px, 3vw, 40px); }
  .intro .display { max-width: 18ch; color: var(--tide); font-size: clamp(34px, 5vw, 80px); }
  .bar-wrap { position: sticky; top: 76px; z-index: 20; padding: 12px 0; background: rgba(245, 245, 242, .94); backdrop-filter: blur(8px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .bar { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .bar label { display: grid; gap: 2px; min-width: 0; padding: 8px 14px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
  .bar label:focus-within { border-color: var(--tide); }
  .bar span { font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--coral); }
  .bar select { width: 100%; min-width: 0; padding: 2px 0; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; text-overflow: ellipsis; }
  .bar select:focus { outline: none; }
  .bar select.on { color: var(--coral); }
  .bar__sort { background: var(--sand) !important; }
  .results { padding-top: 24px; padding-bottom: clamp(64px, 8vw, 120px); }
  .list__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 22px; color: var(--muted); font-size: 14px; }
  .list__bar strong { color: var(--tide); font-size: 18px; }
  .active { display: flex; flex-wrap: wrap; gap: 6px; }
  .active :global(.tag) { display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 12px; border: 0; border-radius: 999px; background: var(--tide); color: var(--sand); font-size: 13px; font-weight: 700; }
  .active :global(.tag i) { font-style: normal; color: var(--coral); }
  .active :global(.tag:hover) { background: var(--coral); color: var(--tide); }
  .active :global(.tag:hover i) { color: var(--tide); }
  .link { border: 0; background: none; padding: 0; color: var(--coral); font-size: 13px; font-weight: 700; text-decoration: underline; }
  .results .cards { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .empty { display: grid; gap: 10px; padding: 48px 0; color: var(--muted); }
  .empty strong { color: var(--tide); font-size: 20px; }
  .empty__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .zones { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .zones a { display: grid; gap: 4px; padding: 20px; background: var(--sand); border: 1px solid var(--line); border-radius: 10px; transition: background .18s, color .18s; }
  .zones a:hover, .zones .zones__all { background: var(--tide); color: var(--sand); }
  .zones .zones__all:hover { background: var(--coral); color: var(--tide); }
  .zones strong { font-size: 18px; letter-spacing: -.02em; }
  .zones span { font-size: 13px; opacity: .7; }
  @media (max-width: 1100px) { .bar { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .bar-wrap { position: static; }
    .bar { grid-template-columns: 1fr 1fr; gap: 6px; }
    .bar label { padding: 7px 12px; }
  }
</style>
