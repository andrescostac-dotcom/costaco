---
interface Props {
  tone?: 'tide' | 'sand' | 'white';
  lockup?: 'full' | 'short' | 'mark';
  class?: string;
}
const { tone = 'tide', lockup = 'short', class: cls = '' } = Astro.props;
const color = tone === 'white' ? '#ffffff' : tone === 'sand' ? '#F3EFE7' : '#12372F';
---
{lockup === 'mark' ? (
  <svg class={`logo-mark ${cls}`} style={`color:${color}`} viewBox="0 0 72 72" fill="none" aria-hidden="true">
    <path d="M34 9H24C12.5 9 6 18 6 36s6.5 27 18 27h10V51H26c-6 0-9-5-9-15s3-15 9-15h8V9Z" fill="currentColor" />
    <path d="M38 9h10c11.5 0 18 9 18 27s-6.5 27-18 27H38V51h8c6 0 9-5 9-15s-3-15-9-15h-8V9Z" fill="currentColor" />
    <circle cx="36" cy="36" r="3.25" fill="#E96B4C" />
  </svg>
) : (
  <span class={`brand-lockup ${cls}`} style={`color:${color}`}>
    <svg class="brand-lockup__mark" viewBox="0 0 72 72" fill="none" aria-hidden="true">
      <path d="M34 9H24C12.5 9 6 18 6 36s6.5 27 18 27h10V51H26c-6 0-9-5-9-15s3-15 9-15h8V9Z" fill="currentColor" />
      <path d="M38 9h10c11.5 0 18 9 18 27s-6.5 27-18 27H38V51h8c6 0 9-5 9-15s-3-15-9-15h-8V9Z" fill="currentColor" />
      <circle cx="36" cy="36" r="3.25" fill="#E96B4C" />
    </svg>
    <span>
      <span class="brand-lockup__name">Costa <span>&amp;</span> Co</span>
      {lockup === 'full' && <span class="brand-lockup__descriptor" style="display:block">Inmobiliaria</span>}
    </span>
  </span>
)}
