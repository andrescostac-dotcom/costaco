---
interface Props {
  tone?: 'dark' | 'white' | 'tide' | 'sand';
  lockup?: 'full' | 'short';
  class?: string;
}
const { tone = 'dark', lockup = 'full', class: cls = '' } = Astro.props;
const color = tone === 'white' || tone === 'sand' ? '#FFFFFF' : '#0B0C0B';
---
<span class={`brand-lockup ${cls}`} style={`color:${color}`}>
  <span class="brand-lockup__name">Costa <span>&amp;</span> co</span>
  {lockup === 'full' && <span class="brand-lockup__descriptor">Inmobiliaria</span>}
</span>
