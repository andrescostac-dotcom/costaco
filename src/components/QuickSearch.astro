---
import ZonaOptions from './ZonaOptions.astro';
import { getPropiedades } from '../lib';
const todas = await getPropiedades();
const tipos = [...new Set(['Casa', 'Departamento', 'PH', 'Lote', ...todas.map((p) => p.data.tipo)])];
---
<form class="qs" action="/propiedades/" method="get" role="search" aria-label="Buscar propiedades" data-qs>
  <label><span>Operación</span>
    <select name="operacion" id="qs-op"><option value="">Todas</option><option>Venta</option><option>Alquiler</option></select>
  </label>
  <label><span>Tipo</span>
    <select name="tipo" id="qs-tipo"><option value="">Todos</option>{tipos.map((t) => <option>{t}</option>)}</select>
  </label>
  <label><span>Zona</span>
    <select name="zona" id="qs-zona"><option value="">CABA y Zona Norte</option><ZonaOptions /></select>
  </label>
  <label><span>Ambientes</span>
    <select name="amb" id="qs-amb"><option value="">Todos</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select>
  </label>
  <button class="btn btn-coral" type="submit">Buscar</button>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-qs]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = new URLSearchParams();
      new FormData(f).forEach((v, k) => { if (v) q.set(k, String(v)); });
      const base = f.getAttribute('action') || 'propiedades/';
      window.location.href = base + (q.toString() ? '#' + q.toString() : '');
    }),
  );
</script>
<style>
  .qs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) auto; align-items: stretch; padding: 8px; background: var(--paper); color: var(--ink); border-radius: 14px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); }
  .qs label { display: grid; gap: 2px; min-width: 0; padding: 8px 16px; border-right: 1px solid var(--line); }
  .qs span { font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--coral); }
  .qs select { width: 100%; min-width: 0; border: 0; padding: 4px 0; background: transparent; font: inherit; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer; text-overflow: ellipsis; }
  .qs select:focus { outline: none; }
  .qs label:focus-within { background: var(--sand); border-radius: 8px; }
  .qs .btn { min-height: 56px; margin-left: 8px; padding: 0 32px; border-radius: 10px; }
  @media (max-width: 860px) {
    .qs { grid-template-columns: 1fr 1fr; gap: 6px; }
    .qs label { border-right: 0; background: var(--sand); border-radius: 8px; }
    .qs .btn { grid-column: 1 / -1; margin: 0; }
  }
  @media (max-width: 380px) { .qs { grid-template-columns: 1fr; } }
</style>
