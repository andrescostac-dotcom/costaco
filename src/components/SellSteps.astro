---
const pasos = [
  ['Visita', 'Conocemos tu propiedad y lo que necesitás.'],
  ['Tasación', 'Definimos un valor estratégico con datos reales del mercado.'],
  ['Presentación', 'Fotos, planos y una descripción que la haga destacar.'],
  ['Difusión', 'Publicamos en portales, redes y nuestra base de compradores.'],
  ['Visitas', 'Filtramos interesados y acompañamos cada recorrida.'],
  ['Seguimiento', 'Te informamos cada consulta, avance y oferta.'],
  ['Cierre', 'Negociamos, coordinamos escribanía y concretamos la venta.'],
];
---
<ol class="steps">
  {pasos.map(([t, d], i) => (
    <li>
      <span class="steps__n">{i + 1}</span>
      <strong>{t}</strong>
      <p>{d}</p>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); counter-reset: s; position: relative; }
  .steps::before { content: ""; position: absolute; top: 27px; left: 28px; right: 28px; height: 1px; background: var(--coral); opacity: .6; }
  .steps li { position: relative; padding-right: 16px; }
  .steps__n { position: relative; display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: 20px; border-radius: 50%; background: var(--tide); color: var(--sand); font-family: var(--serif); font-size: 24px; box-shadow: 0 0 0 6px var(--sand); }
  .paper .steps__n { box-shadow: 0 0 0 6px var(--paper); }
  .steps strong { display: block; margin-bottom: 6px; font-size: 17px; letter-spacing: -.02em; color: var(--tide); }
  .steps p { font-size: 14px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps::before { top: 28px; bottom: 28px; left: 27px; right: auto; width: 1px; height: auto; }
    .steps li { display: grid; grid-template-columns: 56px 1fr; column-gap: 20px; padding: 0 0 24px; }
    .steps__n { grid-row: span 2; margin: 0; }
    .steps strong { align-self: end; }
  }
</style>
