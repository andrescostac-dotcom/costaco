---
// Logo de CosCor con descriptor "Real Estate" (según brandbook).
interface Props { inverse?: boolean; descriptor?: boolean; class?: string }
const { inverse = true, descriptor = true, class: cls = '' } = Astro.props;
---
<span class:list={['coscor-logo', { inverse }, cls]} aria-label={`CosCor${descriptor ? ' Real Estate' : ''}`}>
  <span class="coscor"><span>Cos</span><span>Cor</span></span>
  {descriptor && <span class="coscor-logo__descriptor">Real Estate</span>}
</span>
